DATABASE_URL="postgresql://postgres:[YOUR_URL_ENCODED_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
NEXT_PUBLIC_APP_URL="https://shareinvite.in"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Cloudflare R2 — for photo + audio storage (free tier: 10 GB / 1M writes / month)
# Setup: https://dash.cloudflare.com → R2 → Create bucket → API tokens
# Enable "Public Access" on the bucket to get NEXT_PUBLIC_R2_PUBLIC_URL
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="invite-media"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# Google Tag Manager — get from https://tagmanager.google.com
# Format: GTM-XXXXXXX (leave blank to disable GTM)
NEXT_PUBLIC_GTM_ID=""

# Microsoft Clarity (screen recordings + heatmaps) — https://clarity.microsoft.com
# Settings → Overview → Project ID, e.g. "abcd1234ef" (leave blank to disable)
NEXT_PUBLIC_CLARITY_ID=""

# Password for the admin pages: /admin/activity?token=… and /admin/requests?token=…
ADMIN_SECRET=""

# Google Search Console verification token
# Get from: https://search.google.com/search-console → Add Property → HTML tag method
# Copy only the 'content' value from the meta tag, e.g. "abc123XYZ..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Google sign-in / sign-up (OAuth) — get from https://console.cloud.google.com
# APIs & Services → Credentials → Create OAuth client ID (Web application).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google   (local dev)
#   https://shareinvite.in/api/auth/callback/google   (production)
# NEVER put the real values in this file (it is committed to git) — put them in
# .env.local for dev and in your host's environment variables for production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# If your database password contains special characters, encode them for URLs.
# Example: @ becomes %40

# Email: the payment receipt and "your invitation is live" (lib/mail.ts).
# Gmail SMTP by default. Turn on 2-Step Verification for the Gmail account, then
# create an App Password (Google Account → Security → App passwords).
SMTP_USER="you@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="ShareInvite <you@gmail.com>"
# Only for a provider other than Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
