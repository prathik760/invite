generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  password     String?
  createdAt    DateTime      @default(now())
  events       Event[]
  subscription Subscription?
}

model Template {
  id           String  @id @default(cuid())
  name         String
  previewImage String
  config       Json
  events       Event[]
}

model Event {
  id         String   @id @default(cuid())
  slug       String   @unique
  templateId String
  template   Template @relation(fields: [templateId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  data       Json
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())
  wishes     Wish[]
}

model Wish {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  message    String
  // Guest wishes publish straight to the invitation — no host approval step.
  // The column is kept so a host can still take a wish down (see DELETE
  // /api/wishes/[id]); it is no longer a gate on first appearance.
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  plan              String    @default("free")
  status            String    @default("active")
  razorpayPaymentId String?
  razorpayOrderId   String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// One row per thing a visitor did on the site: a page opened, a design
// previewed, a builder step finished, a payment window closed. Written by
// /api/activity from lib/journal.ts and read by /admin/activity. A visitor is
// an anonymous id kept in their browser; userId is filled once they sign in.
// Deleted after ACTIVITY_DAYS by the daily cleanup job (lib/retention.ts).
model Activity {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String
  userId    String?
  name      String
  path      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([createdAt])
  @@index([userId])
}

// Pages fetched by bots (search engines, AI assistants, link previews), one
// row per bot, page and day (India time) with a running count — so the table
// grows with the number of pages, not with traffic. middleware.ts →
// /api/bot-hit; shown on the Bots tab of /admin/activity; kept ACTIVITY_DAYS.
model BotHit {
  day    String
  bot    String
  kind   String
  path   String
  hits   Int      @default(1)
  lastAt DateTime @default(now())

  @@id([day, bot, path])
}

// Uploads by signed-out visitors, counted per address per clock hour so every
// server instance enforces the same limit (lib/uploadQuota.ts). The key is a
// keyed hash of the address and the hour, never the address itself. Rows are
// deleted by the daily cleanup once their hour is over.
model UploadQuota {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
